<?xml version="1.0" encoding="utf-8"?>

<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Orange glow -->

    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">

        <shape>

            <corners
                android:radius="18dp" />

            <solid
                android:color="#301F1200" />

            <stroke
                android:width="4dp"
                android:color="#40FF8A00" />

        </shape>

    </item>


    <!-- Main dropdown -->

    <item
        android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="5dp">

        <shape>

            <corners
                android:radius="15dp" />

            <solid
                android:color="#171D24" />

            <stroke
                android:width="1.5dp"
                android:color="#FF8A00" />

        </shape>

    </item>

</layer-list>