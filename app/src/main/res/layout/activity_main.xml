<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101419">

    <!-- ================================================= -->
    <!-- Hidden compatibility views -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtWifiStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/txtEcuStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/txtDashboardEcuStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/txtDashboardEcuType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/txtDashboardEcuProtocol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/txtVehicleProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/txtBatteryStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>


    <!-- ================================================= -->
    <!-- TOP HEADER -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp">

        <!-- ================================================= -->
        <!-- YADRA + CONNECTION LOGOS -->
        <!-- ================================================= -->

        <RelativeLayout
            android:id="@+id/connectionStatusBar"
            android:layout_width="match_parent"
            android:layout_height="54dp">

            <!-- ============================================= -->
            <!-- LEFT STATUS LOGOS -->
            <!-- ============================================= -->

            <LinearLayout
                android:id="@+id/leftStatusLogos"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/statusGps"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_status_gps"
                    android:contentDescription="GPS"
                    android:scaleType="centerInside" />

                <ImageView
                    android:id="@+id/statusBluetooth"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_status_bluetooth"
                    android:contentDescription="Bluetooth"
                    android:scaleType="centerInside" />

            </LinearLayout>


            <!-- ============================================= -->
            <!-- YADRA EXACT CENTER -->
            <!-- ============================================= -->

            <com.example.yadra.ShimmerTextView
                android:id="@+id/txtDashboardTitle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:text="YADRA"
                android:textColor="#D9A441"
                android:textSize="30sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:clickable="false"
                android:focusable="false" />


            <!-- ============================================= -->
            <!-- RIGHT STATUS LOGOS -->
            <!-- ============================================= -->

            <LinearLayout
                android:id="@+id/rightStatusLogos"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/statusWifi"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/ic_status_wifi"
                    android:contentDescription="Wi-Fi"
                    android:scaleType="centerInside" />

                <ImageView
                    android:id="@+id/statusEcu"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/ic_status_ecu"
                    android:contentDescription="ECU"
                    android:scaleType="centerInside" />

            </LinearLayout>

        </RelativeLayout>


        <!-- ================================================= -->
        <!-- VEHICLE PROFILE DROPDOWN -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/bg_vehicle_profile_dropdown">

            <!-- Car icon -->

            <ImageView
                android:id="@+id/imgVehicleProfile"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:contentDescription="Vehicle"
                android:src="@drawable/ic_vehicle_profile"
                android:scaleType="centerInside" />


            <!-- Profile name -->

            <AutoCompleteTextView
                android:id="@+id/dropdownVehicleProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:hint="خودرو انتخاب نشده"
                android:inputType="none"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8D99A6"
                android:textSize="15sp"
                android:textStyle="bold" />


            <!-- Dropdown arrow -->

            <TextView
                android:id="@+id/txtVehicleDropdownArrow"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="▼"
                android:textColor="#FF8A00"
                android:textSize="15sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- CONNECTION STATUS -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/txtDashboardStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="● ECU Disconnected"
            android:textColor="#8D99A6"
            android:textSize="13sp" />

    </LinearLayout>


    <!-- ================================================= -->
    <!-- ROTATING DASHBOARD -->
    <!-- ================================================= -->

    <com.example.yadra.RotatingDashboardView
        android:id="@+id/rotatingDashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="170dp"
        android:layout_marginBottom="30dp" />


    <!-- ================================================= -->
    <!-- BOTTOM HINT -->
    <!-- ================================================= -->

    <TextView
        android:id="@+id/txtRotateHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="14dp"
        android:gravity="center"
        android:text="Swipe to rotate"
        android:textColor="#66727E"
        android:textSize="12sp" />


    <!-- ================================================= -->
    <!-- OLD BUTTON IDS -->
    <!-- فقط برای سازگاری -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnVehicleProfile"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnConnection"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnEcu"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnActuators"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnSensors"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnErrors"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnWarnings"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnAI"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnSupport"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnService"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnTrip"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnSubscription"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnSettings"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnCharts"
            android:layout_width="1dp"
            android:layout_height="1dp" />

    </LinearLayout>

</FrameLayout>