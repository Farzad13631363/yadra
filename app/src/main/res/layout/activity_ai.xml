<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101419">

    <!-- Header -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:background="#171D24">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AI Diagnosis"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtAiStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● AI Ready"
            android:textColor="#00E676"
            android:textSize="13sp" />

    </LinearLayout>


    <!-- Conversation -->

    <ScrollView
        android:id="@+id/scrollAiConversation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="14dp">

        <LinearLayout
            android:id="@+id/layoutAiMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Welcome message -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#171D24">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🤖 دستیار هوشمند Yadra"
                        android:textColor="#7E57C2"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="کد خطا، علائم خرابی یا اطلاعات ECU را بپرسید. می‌توانم در بررسی اولیه مشکل خودرو کمک کنم."
                        android:textColor="#CFD8DC"
                        android:textSize="15sp"
                        android:lineSpacingExtra="3dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- Quick questions -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="سؤال‌های سریع"
                android:textColor="#90A4AE"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnAskDtc"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="8dp"
                    android:text="🔧 این کد خطا یعنی چه؟"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#263238" />

                <Button
                    android:id="@+id/btnAskSymptoms"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="8dp"
                    android:text="🚗 مشکل خودرو را بررسی کن"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#263238" />

                <Button
                    android:id="@+id/btnAnalyzeEcu"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="📊 اطلاعات ECU را تحلیل کن"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#263238" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- Input Area -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="#171D24">

        <EditText
            android:id="@+id/editAiQuestion"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:hint="سؤال خود را بنویسید..."
            android:textColor="#FFFFFF"
            android:textColorHint="#78909C"
            android:textSize="15sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:backgroundTint="#546E7A"
            android:inputType="textMultiLine"
            android:maxLines="3" />

        <Button
            android:id="@+id/btnSendAi"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:text="➤"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="0dp"
            android:backgroundTint="#1976D2"
            android:contentDescription="Send" />

    </LinearLayout>

</LinearLayout>