<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Warning Lights"
            android:textColor="#17191D"
            android:textSize="27sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="چراغ‌های هشدار و نشانگر خودرو"
            android:textColor="#6B7078"
            android:textSize="15sp"
            android:paddingBottom="16dp" />

        <!-- Cluster legend -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:gravity="center_vertical">

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="#DC2626" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  خطر"
                android:textColor="#333333"
                android:textSize="13sp" />

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="18dp"
                android:background="#F59E0B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  بررسی"
                android:textColor="#333333"
                android:textSize="13sp" />

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="18dp"
                android:background="#16A34A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  فعال"
                android:textColor="#333333"
                android:textSize="13sp" />

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="18dp"
                android:background="#2563EB" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  روشنایی"
                android:textColor="#333333"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtWarningStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Warning Light Reference"
            android:textColor="#555A63"
            android:textSize="14sp"
            android:paddingTop="16dp"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:id="@+id/warningContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>