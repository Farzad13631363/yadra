<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ECU Connection Test"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ECU Protocol"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:paddingTop="4dp"
            android:paddingBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerProtocol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:spinnerMode="dropdown"
            android:padding="4dp" />

        <TextView
            android:id="@+id/txtEcuStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:padding="12dp" />

        <TextView
            android:id="@+id/txtProtocol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Protocol: —"
            android:textSize="16sp"
            android:textColor="#444444"
            android:padding="12dp" />

        <TextView
            android:id="@+id/txtEcuResponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0100 Response: —"
            android:textSize="15sp"
            android:textColor="#555555"
            android:padding="12dp" />

        <TextView
            android:id="@+id/txtRpm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RPM: —"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnTestEcu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Test ECU Connection" />

    </LinearLayout>

</ScrollView>